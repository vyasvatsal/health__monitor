// ============== METADATA CACHE ==============
$GLOBALS['metadata_cache'] = [];

function getPageMetadataOnce($url)
{
    if (isset($GLOBALS['metadata_cache'][$url])) {
        return $GLOBALS['metadata_cache'][$url];
    }

    $meta = [
        'lastmod' => null,
        'changefreq' => 'monthly',
        'priority' => 0.5
    ];

    // Try to get Last-Modified from headers (fast)
    $headers = @get_headers($url, 1);
    if (!empty($headers['Last-Modified'])) {
        $meta['lastmod'] = date('c', strtotime($headers['Last-Modified']));
    }

    // Fetch HTML for meta tags
    $html = @file_get_contents($url, false, stream_context_create([
        'http' => [
            'method' => 'GET',
            'header' => "User-Agent: " . USER_AGENT . "\r\n",
            'timeout' => 5
        ],
        'ssl' => [
            'verify_peer' => false,
            'verify_peer_name' => false
        ]
    ]));

    if ($html) {
        libxml_use_internal_errors(true);
        $dom = new DOMDocument();
        @$dom->loadHTML($html);
        libxml_clear_errors();

        // Look for article:modified_time
        foreach ($dom->getElementsByTagName('meta') as $m) {
            $prop = $m->getAttribute('property');
            $content = $m->getAttribute('content');
            if ($prop === 'article:modified_time' && !empty($content)) {
                $meta['lastmod'] = date('c', strtotime($content));
                break;
            }
        }

        // Look for JSON-LD dateModified
        if (!$meta['lastmod']) {
            foreach ($dom->getElementsByTagName('script') as $script) {
                if ($script->getAttribute('type') === 'application/ld+json') {
                    $json = @json_decode($script->textContent, true);
                    if (!empty($json['dateModified'])) {
                        $meta['lastmod'] = date('c', strtotime($json['dateModified']));
                        break;
                    }
                }
            }
        }
    }

    // Fallback to current date if no lastmod found
    if (!$meta['lastmod']) {
        $meta['lastmod'] = date('c');
    }

    // Smart changefreq based on URL patterns
    $urlLower = strtolower($url);
    if (strpos($urlLower, '/blog') !== false || strpos($urlLower, '/news') !== false || strpos($urlLower, '/article') !== false) {
        $meta['changefreq'] = 'weekly';
    } elseif (strpos($urlLower, '/product') !== false || strpos($urlLower, '/shop') !== false) {
        $meta['changefreq'] = 'daily';
    } elseif (strpos($urlLower, '/about') !== false || strpos($urlLower, '/contact') !== false) {
        $meta['changefreq'] = 'yearly';
    }

    // Calculate priority based on URL depth
    $path = parse_url($url, PHP_URL_PATH) ?: '/';
    $depth = substr_count(trim($path, '/'), '/');
    $meta['priority'] = number_format(max(0.1, 1 - ($depth * 0.15)), 1);

    // Cache and return
    $GLOBALS['metadata_cache'][$url] = $meta;
    return $meta;
}

// ============== XML GENERATION - FIXED ==============
function buildSitemapXml(array $urls): string
{
    $xml = '<?xml version="1.0" encoding="UTF-8"?>' . "\n";
    $xml .= '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">' . "\n";

    foreach ($urls as $url) {
        $meta = getPageMetadataOnce($url);

        $xml .= "<url>\n";
        $xml .= "<loc>" . htmlspecialchars($url, ENT_XML1 | ENT_QUOTES, 'UTF-8') . "</loc>\n";
        $xml .= "<lastmod>{$meta['lastmod']}</lastmod>\n";
        $xml .= "<changefreq>{$meta['changefreq']}</changefreq>\n";
        $xml .= "<priority>{$meta['priority']}</priority>\n";
        $xml .= "</url>\n";
    }

    $xml .= "</urlset>";

    return $xml;
}

// ============== TREE STRUCTURE - FIXED FOR PROPER NESTING ==============
function buildTree($urls, $baseUrl)
{
    $baseParsed = parse_url($baseUrl);
    $baseHost = $baseParsed['host'] ?? '';

    $tree = [
        '__url' => $baseUrl,
        '__meta' => null,
        '__label' => $baseHost ?: 'Root',
        '__children' => []
    ];

    foreach ($urls as $url) {
        $meta = getPageMetadataOnce($url);
        $parsed = parse_url($url);
        $path = $parsed['path'] ?? '/';

        // Handle homepage
        if ($path === '/' || $path === '') {
            $tree['__children'][] = [
                '__url' => $url,
                '__meta' => $meta,
                '__label' => 'Homepage',
                '__children' => []
            ];
            continue;
        }

        // Split path into segments
        $pathParts = array_filter(explode('/', trim($path, '/')));

        // Navigate/create nested structure
        $currentLevel = &$tree['__children'];
        $currentPath = '';

        foreach ($pathParts as $index => $segment) {
            $currentPath .= '/' . $segment;
            $isLastSegment = ($index === count($pathParts) - 1);

            // Look for existing node at this level
            $found = false;
            foreach ($currentLevel as &$child) {
                // Match by path segment label
                $childSegment = strtolower(str_replace(['-', '_'], ' ', $segment));
                $childLabel = strtolower($child['__label']);

                if (
                    $childLabel === $childSegment ||
                    (isset($child['__url']) && parse_url($child['__url'], PHP_URL_PATH) === $currentPath)
                ) {
                    $found = true;

                    // If this is the last segment, update the URL and meta
                    if ($isLastSegment) {
                        $child['__url'] = $url;
                        $child['__meta'] = $meta;
                    }

                    // Move to next level
                    $currentLevel = &$child['__children'];
                    break;
                }
            }

            // Create new node if not found
            if (!$found) {
                $label = ucwords(str_replace(['-', '_'], ' ', $segment));
                $label = preg_replace('/\.(html|php|htm)$/', '', $label);

                $newNode = [
                    '__url' => $isLastSegment ? $url : null,
                    '__meta' => $isLastSegment ? $meta : null,
                    '__label' => $label,
                    '__children' => []
                ];

                $currentLevel[] = $newNode;
                $currentLevel = &$currentLevel[count($currentLevel) - 1]['__children'];
            }
        }
    }

    return $tree;
}

function renderTreeHtml($node, $isRoot = true)
{
    $html = '';

    if ($isRoot) {
        $html .= "<ul class='tree-list'>";
        $html .= "<li class='tree-item open'>";
        $html .= "<span class='toggle-btn'>&#9660;</span>";
        $html .= "<span class='tree-label root-label'>" . htmlspecialchars($node['__label']) . "</span>";

        if (!empty($node['__children'])) {
            $html .= "<ul class='tree-list'>";
            foreach ($node['__children'] as $child) {
                $html .= renderTreeHtml($child, false);
            }
            $html .= "</ul>";
        }

        $html .= "</li>";
        $html .= "</ul>";
    } else {
        $hasChildren = !empty($node['__children']);
        $url = $node['__url'] ?? null;
        $meta = $node['__meta'] ?? [];
        $label = $node['__label'] ?? 'Unknown';

        $html .= "<li class='tree-item'>";

        if ($hasChildren) {
            $html .= "<span class='toggle-btn'>&#9654;</span>";
        } else {
            $html .= "<span class='toggle-placeholder'></span>";
        }

        $html .= "<span class='tree-label'>" . htmlspecialchars($label) . "</span>";

        if ($url) {
            $html .= " <span class='tree-separator'>—</span> <a class='tree-link' href='" . htmlspecialchars($url) . "' target='_blank'>"
                . htmlspecialchars($url) . "</a>";

            $html .= "<div class='tree-meta'>
                        📅 <b>Last:</b> " . ($meta['lastmod'] ?? '-') . " &nbsp;
                        ⭐ <b>P:</b> " . ($meta['priority'] ?? '-') . " &nbsp;
                        ⏳ <b>F:</b> " . ($meta['changefreq'] ?? '-') . "
                      </div>";
        }

        if ($hasChildren) {
            $html .= "<ul class='tree-list'>";
            foreach ($node['__children'] as $child) {
                $html .= renderTreeHtml($child, false);
            }
            $html .= "</ul>";
        }

        $html .= "</li>";
    }

    return $html;
}

// ============== UTILITY FUNCTIONS ==============
function getDomainName($url)
{
    $host = parse_url($url, PHP_URL_HOST);
    if (!$host)
        return 'sitemap';

    $host = preg_replace('/^www\./', '', $host);
    $parts = explode('.', $host);
    $domain = $parts[0];

    return ucfirst($domain);
}

function writeTempFile($content, $filename)
{
    $file = sys_get_temp_dir() . '/' . $filename;
    file_put_contents($file, $content);
    return $filename;
}

// ============== FILTER LOGIC ==============
function matchesPathFilter($url, $includeList, $excludeList)
{
    $path = parse_url($url, PHP_URL_PATH) ?: '/';

    foreach ($excludeList as $pattern) {
        $pattern = trim($pattern);
        if (empty($pattern))
            continue;

        $pattern = trim($pattern, '/');

        if (strpos($path, '/' . $pattern) !== false || strpos($path, $pattern . '/') !== false || $path === '/' . $pattern) {
            return false;
        }
    }

    if (empty(array_filter($includeList))) {
        return true;
    }

    foreach ($includeList as $pattern) {
        $pattern = trim($pattern);
        if (empty($pattern))
            continue;

        $pattern = trim($pattern, '/');

        if (strpos($path, '/' . $pattern) !== false || strpos($path, $pattern . '/') !== false || $path === '/' . $pattern) {
            return true;
        }
    }

    return false;
}

// ============== DOWNLOAD HANDLER ==============
if (isset($_GET['action'], $_GET['file']) && $_GET['action'] === 'download') {
    $file = basename($_GET['file']);
    $path = sys_get_temp_dir() . '/' . $file;
    if (!file_exists($path))
        die("File not found");

    $ext = pathinfo($file, PATHINFO_EXTENSION);
    if ($ext === 'xml') {
        header("Content-Type: application/xml; charset=UTF-8");
    } else {
        header("Content-Type: text/html; charset=UTF-8");
    }
    header("Content-Disposition: attachment; filename=\"$file\"");
    readfile($path);
    exit;
}

// ============== MAIN CRAWLER ==============
$report = null;
$fullXmlContent = '';
$error = '';
$debugInfo = [];

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $base = trim($_POST['base_url'] ?? '');
    $includePaths = array_filter(array_map('trim', explode(',', $_POST['include_paths'] ?? '')));
    $excludePaths = array_filter(array_map('trim', explode(',', $_POST['exclude_paths'] ?? '')));

    if (!filter_var($base, FILTER_VALIDATE_URL)) {
        $error = 'Invalid URL';
    }

    if (empty($error)) {
        $base = rtrim($base, '/');
        $domainName = getDomainName($base);

        $timeout = 60;
        $maxUrls = 5000;
        $start = time();

        $normalize = function (string $url): string {
            $u = parse_url($url);
            if (!$u || empty($u['host']))
                return '';
            $scheme = $u['scheme'] ?? 'https';

            $host = preg_replace('/^www\./', '', $u['host']);

            $path = isset($u['path']) ? rtrim($u['path'], '/') : '';
            if ($path === '')
                $path = '/';

            $url = strtolower($scheme . '://' . $host . $path);
            if (isset($u['query']))
                $url .= '?' . $u['query'];
            return $url;
        };

        $fetch = function (string $url) use (&$debugInfo): string|false {
            $opts = [
                'http' => [
                    'method' => 'GET',
                    'header' => "User-Agent: " . USER_AGENT . "\r\nAccept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\n",
                    'timeout' => 10,
                    'follow_location' => 1,
                    'max_redirects' => 3
                ],
                'ssl' => [
                    'verify_peer' => false,
                    'verify_peer_name' => false
                ]
            ];
            $ctx = stream_context_create($opts);
            $html = @file_get_contents($url, false, $ctx);

            if ($html === false) {
                $debugInfo[] = "Failed to fetch: $url";
            }

            return $html;
        };

        $urlToAbsolute = function (string $base, string $rel): string|false {
            if (parse_url($rel, PHP_URL_SCHEME) != '')
                return $rel;
            if (substr($rel, 0, 2) === '//') {
                $scheme = parse_url($base, PHP_URL_SCHEME);
                return $scheme . ':' . $rel;
            }
            $baseParts = parse_url($base);
            if (!isset($baseParts['scheme'], $baseParts['host']))
                return false;
            $basePath = $baseParts['path'] ?? '/';
            $basePath = preg_replace('#/[^/]*$#', '/', $basePath);
            $path = ($rel[0] === '/') ? $rel : ($basePath . $rel);
            $segments = explode('/', $path);
            $resolved = [];
            foreach ($segments as $segment) {
                if ($segment === '..')
                    array_pop($resolved);
                elseif ($segment !== '.' && $segment !== '')
                    $resolved[] = $segment;
            }
            return $baseParts['scheme'] . '://' . $baseParts['host'] . '/' . implode('/', $resolved);
        };

        $extractLinks = function (string $html, string $base) use ($urlToAbsolute): array {
            $links = [];
            libxml_use_internal_errors(true);
            $dom = new DOMDocument();
            @$dom->loadHTML($html);
            libxml_clear_errors();
            foreach ($dom->getElementsByTagName('a') as $a) {
                $href = trim($a->getAttribute('href'));
                if (!$href || str_starts_with($href, 'mailto:') || str_starts_with($href, 'javascript:') || str_starts_with($href, 'tel:'))
                    continue;
                if (str_contains(strtolower($a->getAttribute('rel')), 'nofollow'))
                    continue;
                $abs = $urlToAbsolute($base, $href);
                if ($abs)
                    $links[] = strtok($abs, '#');
            }
            return array_unique($links);
        };

        $parseRobots = function (string $base) use (&$debugInfo): array {
            $rules = ['disallow' => [], 'disallowAll' => false];
            $robotsUrl = rtrim($base, '/') . '/robots.txt';
            $robotsTxt = @file_get_contents($robotsUrl);

            if (!$robotsTxt) {
                $debugInfo[] = "No robots.txt found";
                return $rules;
            }

            $debugInfo[] = "Found robots.txt";
            $userAgentMatch = false;

            foreach (explode("\n", $robotsTxt) as $line) {
                $line = trim(preg_replace('/#.*/', '', $line));

                if (stripos($line, 'User-agent:') === 0) {
                    $agent = trim(substr($line, 11));
                    $userAgentMatch = ($agent === '*' || stripos(USER_AGENT, $agent) !== false);
                    continue;
                }

                if ($userAgentMatch && stripos($line, 'Disallow:') === 0) {
                    $path = trim(substr($line, 9));
                    if ($path === '/') {
                        $rules['disallowAll'] = true;
                        $debugInfo[] = "robots.txt disallows all crawling";
                    } elseif ($path !== '') {
                        $rules['disallow'][] = $path;
                    }
                }
            }
            return $rules;
        };

        $allowedByRobots = function (string $url, array $rules): bool {
            if ($rules['disallowAll'])
                return false;
            $path = parse_url($url, PHP_URL_PATH) ?: '/';
            foreach ($rules['disallow'] as $pattern) {
                $regex = '#^' . str_replace('\*', '.*', preg_quote($pattern, '#')) . '#i';
                if (preg_match($regex, $path))
                    return false;
            }
            return true;
        };

        $robots = $parseRobots($base);
        if ($robots['disallowAll']) {
            $error = 'robots.txt disallows all crawling for this user agent';
        }

        if (empty($error)) {
            $visited = [];
            $queue = [$base];
            $crawled = [];
            $skippedReasons = ['noindex' => 0, 'robots' => 0, 'filtered' => 0, 'fetch_failed' => 0, 'too_short' => 0];

            $baseNormalized = preg_replace('/^(https?:\/\/)www\./', '$1', strtolower($base));

            while ($queue && count($visited) < $maxUrls && (time() - $start) < $timeout) {
                $url = array_shift($queue);
                $urlNorm = $normalize($url);

                if (!$urlNorm || isset($visited[$urlNorm]))
                    continue;
                if (!$allowedByRobots($urlNorm, $robots)) {
                    $skippedReasons['robots']++;
                    continue;
                }

                $html = $fetch($url);

                if ($html === false) {
                    $skippedReasons['fetch_failed']++;
                    continue;
                }

                if (strlen($html) < 50) {
                    $skippedReasons['too_short']++;
                    continue;
                }

                $crawled[] = $url;

                if (preg_match('/<meta\s+name=["\']robots["\']\s+content=["\'][^"\']*noindex[^"\']*["\']\s*\/?>/i', $html)) {
                    $visited[$urlNorm] = false;
                    $skippedReasons['noindex']++;
                    continue;
                }

                if (preg_match('/<link\s+rel=["\']canonical["\']\s+href=["\']([^"\']+)["\']\s*\/?>/i', $html, $m)) {
                    $canonical = $urlToAbsolute($url, $m[1]);
                    if ($canonical && $canonical !== $url && !isset($visited[$normalize($canonical)])) {
                        $queue[] = $canonical;
                    }
                }

                if (matchesPathFilter($urlNorm, $includePaths, $excludePaths)) {
                    $visited[$urlNorm] = $url;
                } else {
                    $visited[$urlNorm] = false;
                    $skippedReasons['filtered']++;
                }

                $links = $extractLinks($html, $url);
                foreach ($links as $link) {
                    if (count($visited) + count($queue) >= $maxUrls)
                        break;

                    $linkNormalized = preg_replace('/^(https?:\/\/)www\./', '$1', strtolower($link));
                    if (strpos($linkNormalized, $baseNormalized) !== 0)
                        continue;

                    $linkNorm = $normalize($link);
                    if ($linkNorm && !isset($visited[$linkNorm]))
                        $queue[] = $link;
                }
            }

            $finalUrls = array_values(array_filter($visited));

            $debugInfo[] = "Total crawled: " . count($crawled);
            $debugInfo[] = "Passed filters: " . count($finalUrls);
            $debugInfo[] = "Skipped - noindex: " . $skippedReasons['noindex'];
            $debugInfo[] = "Skipped - robots.txt: " . $skippedReasons['robots'];
            $debugInfo[] = "Skipped - filtered: " . $skippedReasons['filtered'];
            $debugInfo[] = "Skipped - fetch failed: " . $skippedReasons['fetch_failed'];

            if (empty($finalUrls)) {
                $error = 'No crawlable pages found. Check information below.';
            } else {
                sort($finalUrls);

                $xmlStr = buildSitemapXml($finalUrls);

                $domainName = preg_replace('/[^a-zA-Z0-9_-]/', '', $domainName);
                $xmlFilename = $domainName . 'Sitemap.xml';
                $xmlFilePath = sys_get_temp_dir() . DIRECTORY_SEPARATOR . $xmlFilename;

                // FIX: Use trim() to remove leading/trailing whitespace before saving
                file_put_contents($xmlFilePath, trim($xmlStr), LOCK_EX);

                $fullXmlContent = $xmlStr;

                $tree = buildTree($finalUrls, $base);
                $treeHtmlContent = '<!DOCTYPE html><html><head><meta charset="utf-8"><title>Sitemap Tree - ' . $domainName . '</title>' .
                    '<style>
                    .body-root { font-family:Arial;background:#f4f4f4;color:#333;padding:20px;}
                    .tree-list {list-style:none;padding-left:20px;margin:8px 0;}
                    .tree-item {margin:8px 0; position:relative;}
                    .toggle-btn { cursor:pointer; user-select:none; display:inline-block; width:20px; color:#007bff; font-weight:bold; transition: transform 0.2s;}
                    .toggle-placeholder {display:inline-block; width:20px;}
                    .tree-label {margin-right:8px; font-weight:500; color:#333;}
                    .root-label { font-weight:700; font-size:18px; color:#667eea;}
                    .tree-separator { color:#999; margin:0 8px;}
                    .tree-link { color:#007bff; text-decoration:none; word-break:break-all;}
                    .tree-link:hover { text-decoration:underline;}
                    .tree-meta { font-size:12px; color:#666; margin:4px 0 0 40px; padding:8px; background:#f9f9f9; border-radius:4px; display:inline-block;}
                    .tree-item > .tree-list { display:none; }
                    .tree-item.open > .tree-list { display:block; }
                    .tree-item.open > .toggle-btn { transform: rotate(90deg);}
                    .controls { margin:20px 0; }
                    .controls button { padding:10px 20px; margin-right:10px; background:#667eea; color:white; border:none; border-radius:5px; cursor:pointer; font-weight:600;}
                    .controls button:hover { background:#5568d3;}
                    </style>
                    </head><body class="body-root">
                    <h2>Sitemap Tree - ' . $domainName . '</h2>
                    <div class="controls">
                        <button id="expandAll">Expand All</button>
                        <button id="collapseAll">Collapse All</button>
                    </div>';
                $treeHtmlContent .= renderTreeHtml($tree, true);
                $treeHtmlContent .= '<script>
                function setOpen(elem, open) {
                    if(open) elem.classList.add("open");
                    else elem.classList.remove("open");
                }
                document.querySelectorAll(".toggle-btn").forEach(function(btn){
                    btn.addEventListener("click", function(){
                        var li = btn.parentElement;
                        setOpen(li, !li.classList.contains("open"));
                    });
                });
                document.getElementById("expandAll").onclick = function(){
                    document.querySelectorAll(".tree-item").forEach(function(li){ setOpen(li,true); });
                };
                document.getElementById("collapseAll").onclick = function(){
                    document.querySelectorAll(".tree-item").forEach(function(li){ setOpen(li,false); });
                };
                </script></body></html>';

                $treeFilename = $domainName . 'SitemapTree.html';
                $treeFile = writeTempFile($treeHtmlContent, $treeFilename);

                $report = [
                    'count' => count($finalUrls),
                    'crawled' => count($crawled),
                    'excluded' => count($crawled) - count($finalUrls),
                    'downloads' => [
                        'XML Sitemap' => $xmlFilename,
                        'HTML Tree' => $treeFile
                    ]
                ];
            }
        }
    }
}
